# VARIABLES COMUNES docker compose Y MONTADAS EN CADA CONTAINER

COMPOSE_PROJECT_NAME=practica-ra04

# Interfaces de red del router
WAN_IF=eth2
LAN_IF=eth1
SERVERS_IF=eth0

# Subredes
SERVERS_SUBNET=192.168.52.0/24
LAN_SUBNET=192.168.51.0/24

# Direcciones IP del router
SERVERS_ROUTER_IP=192.168.52.254
LAN_ROUTER_IP=192.168.51.254

# Servidores y clientes
HTTP_IP=192.168.52.10
MYSQL_IP=192.168.52.20
CLIENTE_ADMIN_IP=192.168.51.151
CLIENTE_IP=192.168.51.152

# Base de datos MariaDB
MARIADB_ROOT_PASSWORD=root1234
MARIADB_DATABASE=practica
MARIADB_USER=alumno
MARIADB_PASSWORD=alumno1234
